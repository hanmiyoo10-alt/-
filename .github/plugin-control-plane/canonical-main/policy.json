{
  "schemaVersion": 1,
  "bootstrap": {
    "profiles": ["production-state-block", "registered-renderer", "check-only"],
    "defaultAlertPolicy": "repo-default"
  },
  "events": {
    "classes": [
      "MAIN_WRITE",
      "REQUIRED_CI",
      "PR_STATE",
      "ISSUE_STATE",
      "PRODUCTION_AUTHORITY",
      "DURABLE_MEMORY_SYNC",
      "PROJECT_BOOTSTRAP",
      "CONTROL_PLANE",
      "RELEASE_VALIDATION"
    ],
    "dispositions": [
      "IGNORE_NORMAL",
      "STATUS_REFRESH",
      "RECORD_EVIDENCE",
      "FEEDBACK_CANDIDATE",
      "RECOVERY_FEEDBACK_CANDIDATE",
      "ESCALATION_CANDIDATE"
    ]
  },
  "alerts": {
    "severities": ["P0", "P1", "P2", "P3"],
    "defaultSeverity": {
      "MAIN_WRITE_CONTENT_CONFLICT": "P0",
      "MAIN_WRITE_RETRY_EXHAUSTED": "P0",
      "RELEASE_AUTHORITY_IDENTITY_MISMATCH": "P0",
      "UNDECLARED_AUTHORITY_MIGRATION": "P0",
      "MEMORY_SYNC_PATH_ESCAPE": "P0",
      "REQUIRED_CHECK_FAILED": "P1",
      "MEMORY_SYNC_FAILED": "P1",
      "PROJECT_BOOTSTRAP_VALIDATION_FAILED": "P1",
      "RELEASE_VALIDATION_FAILED": "P1",
      "CONTROL_PLANE_REFRESH_FAILED": "P2",
      "SCOPE_UNCLASSIFIED_PERSISTENT": "P2",
      "REAL_DEVICE_VALIDATION_PENDING": "P2",
      "NORMAL_PR_ACTIVITY": "P3",
      "REQUIRED_CHECK_STILL_PASSING": "P3",
      "MEMORY_SYNC_ALREADY_APPLIED": "P3"
    },
    "nonDowngradable": [
      "MAIN_WRITE_CONTENT_CONFLICT",
      "MAIN_WRITE_RETRY_EXHAUSTED",
      "RELEASE_AUTHORITY_IDENTITY_MISMATCH",
      "UNDECLARED_AUTHORITY_MIGRATION",
      "MEMORY_SYNC_PATH_ESCAPE"
    ]
  },
  "operations": {
    "issueTitle": "[repo-ops:main]",
    "recentRecoveryLimit": 10,
    "projectStatusFreshnessMinutes": 150,
    "eventAdaptersComplete": false
  }
}
