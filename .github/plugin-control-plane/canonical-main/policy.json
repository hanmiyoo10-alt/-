{
  "schemaVersion": 1,
  "bootstrap": {
    "profiles": ["production-state-block", "registered-renderer", "check-only"],
    "defaultAlertPolicy": "repo-default",
    "sharedInteractionContract": ".github/plugin-control-plane/canonical-main/shared-interaction-contract.md"
  },
  "events": {
    "classes": ["MAIN_WRITE", "REQUIRED_CI", "PR_STATE", "ISSUE_STATE", "PRODUCTION_AUTHORITY", "DURABLE_MEMORY_SYNC", "PROJECT_BOOTSTRAP", "CONTROL_PLANE", "RELEASE_VALIDATION"],
    "dispositions": ["IGNORE_NORMAL", "STATUS_REFRESH", "RECORD_EVIDENCE", "FEEDBACK_CANDIDATE", "RECOVERY_FEEDBACK_CANDIDATE", "ESCALATION_CANDIDATE"]
  },
  "alerts": {
    "severities": ["P0", "P1", "P2", "P3"],
    "defaultSeverity": {
      "MAIN_WRITE_CONTENT_CONFLICT": "P0",
      "MAIN_WRITE_RETRY_EXHAUSTED": "P0",
      "RELEASE_AUTHORITY_IDENTITY_MISMATCH": "P0",
      "UNDECLARED_AUTHORITY_MIGRATION": "P0",
      "MEMORY_SYNC_PATH_ESCAPE": "P0",
      "REQUIRED_CHECK_FAILED": "P1",
      "MEMORY_SYNC_FAILED": "P1",
      "PROTECTION_GUARD_FAILED": "P1",
      "PROJECT_BOOTSTRAP_VALIDATION_FAILED": "P1",
      "RELEASE_VALIDATION_FAILED": "P1",
      "OPS_REFRESH_FAILED": "P2",
      "CONVERGENCE_STALE": "P2",
      "UNSTABLE_COMPONENT": "P2",
      "CONTROL_PLANE_REFRESH_FAILED": "P2",
      "SCOPE_UNCLASSIFIED_PERSISTENT": "P2",
      "REAL_DEVICE_VALIDATION_PENDING": "P2",
      "NORMAL_PR_ACTIVITY": "P3",
      "REQUIRED_CHECK_STILL_PASSING": "P3",
      "MEMORY_SYNC_ALREADY_APPLIED": "P3"
    },
    "nonDowngradable": ["MAIN_WRITE_CONTENT_CONFLICT", "MAIN_WRITE_RETRY_EXHAUSTED", "RELEASE_AUTHORITY_IDENTITY_MISMATCH", "UNDECLARED_AUTHORITY_MIGRATION", "MEMORY_SYNC_PATH_ESCAPE"]
  },
  "notifications": {
    "outboxEnabled": true,
    "channels": ["email"],
    "severities": ["P0", "P1"],
    "includeRecovery": true,
    "deliveryBridge": "chatgpt-github-gmail-condition-watch",
    "bridgeState": "ACTIVE_PROVEN",
    "bridgeCadence": "hourly",
    "bridgeContract": ".github/plugin-control-plane/canonical-main/native-mail-bridge.json",
    "aggregation": {
      "enabled": true,
      "unit": "system-per-check",
      "groupBy": "most-specific-operational-scope",
      "maxMessagesPerSystemPerCheck": 1,
      "mergeAcrossSystems": false,
      "preserveIndividualDeliveryKeys": true,
      "preserveIndividualReceipts": true,
      "sameCorrelationOpenRecovered": "single-bundle-history"
    },
    "receiptTracking": {
      "enabled": true,
      "source": "incident-comments",
      "statuses": ["DELIVERED", "FAILED", "SUPPRESSED_DUPLICATE"],
      "maxIncidentIssues": 25,
      "baselineProofAt": "2026-08-25T03:25:00Z"
    }
  },
  "stability": {
    "convergenceBudgetSeconds": 300,
    "flapThreshold": 3,
    "flapWindowSeconds": 300,
    "flapQuietSeconds": 300
  },
  "protection": {
    "contract": ".github/plugin-control-plane/canonical-main/protected-main.json",
    "observeBranchApi": true,
    "operatorSurface": true,
    "automaticActivationAttempt": true,
    "softEnforcementFallback": true
  },
  "adapters": {
    "observationEpoch": "2026-08-24T20:37:22Z",
    "requiredCi": {"workflow": "simcore-ci.yml", "requiredJob": "Required"},
    "productionAuthority": {"simcore": {"manifest": "product-manifest.json"}},
    "writerWorkflows": [
      {"id": "simcore-release-state-sync", "workflow": "simcore-release-state-sync.yml", "scope": ["plugin:simcore"], "events": ["push", "workflow_run", "workflow_dispatch"]},
      {"id": "simcore-r2-7-status-projection", "workflow": "simcore-r2-7-status-projection.yml", "scope": ["plugin:simcore"], "events": ["push"]},
      {"id": "simcore-r2-8-terminal-convergence", "workflow": "product-simcore-terminal-convergence-r2-8.yml", "scope": ["plugin:simcore"], "events": ["push"]},
      {"id": "simcore-candidate-receipt", "workflow": "product-simcore-candidate-materialize.yml", "scope": ["plugin:simcore"], "events": ["push"]},
      {"id": "usage-dashboard-project-memory", "workflow": "usage-dashboard-project-memory.yml", "scope": ["plugin:usage-dashboard"], "events": ["push"]},
      {"id": "canonical-main-protection-guard", "workflow": "canonical-main-protection-guard.yml", "scope": ["scope:repo"], "events": ["push", "workflow_run", "workflow_dispatch"], "failureReason": "PROTECTION_GUARD_FAILED"}
    ],
    "writerInventory": [
      {"workflow": "simcore-release-state-sync.yml", "mode": "active"},
      {"workflow": "simcore-r2-7-status-projection.yml", "mode": "active"},
      {"workflow": "product-simcore-terminal-convergence-r2-8.yml", "mode": "active"},
      {"workflow": "product-simcore-candidate-materialize.yml", "mode": "active"},
      {"workflow": "usage-dashboard-project-memory.yml", "mode": "active"},
      {"workflow": "simcore-release-command.yml", "mode": "legacy-dormant"},
      {"workflow": "repo-main-write-coordination-migration.yml", "mode": "one-shot-migration"}
    ],
    "bootstrap": {"descriptorDir": ".github/plugin-control-plane/canonical-main/descriptors"}
  },
  "operations": {
    "issueTitle": "[repo-ops:main]",
    "recentRecoveryLimit": 10,
    "incidentHistoryLimit": 6,
    "projectStatusFreshnessMinutes": 150,
    "eventAdaptersComplete": true,
    "automationMode": "event-plus-hourly-self-heal",
    "manualActionRequired": false
  }
}
