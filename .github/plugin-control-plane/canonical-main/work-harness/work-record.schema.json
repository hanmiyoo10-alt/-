{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonical-main.local/work-harness/work-record-v1.schema.json",
  "title": "Repository Work Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workId",
    "objectiveId",
    "scopeId",
    "sourceIdeaOrDecision",
    "taskState",
    "gateState",
    "workType",
    "requiredCapability",
    "readAuthorities",
    "writeAuthorities",
    "protectedSurfaces",
    "closeSyncSurfaces",
    "dependsOn",
    "expectedBases",
    "sourceAuthorityRefs",
    "stopCondition"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "objectiveId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "scopeId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "sourceIdeaOrDecision": { "type": "string", "minLength": 1, "maxLength": 500 },
    "taskState": { "type": "string", "minLength": 1, "maxLength": 80 },
    "gateState": {
      "type": "string",
      "enum": ["STARTABLE", "NOT_STARTABLE", "UNKNOWN"]
    },
    "workType": { "type": "string", "minLength": 1, "maxLength": 120 },
    "requiredCapability": { "type": "string", "minLength": 1, "maxLength": 160 },
    "readAuthorities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "refreshableReadAuthorities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 },
      "default": []
    },
    "writeAuthorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "role"],
        "properties": {
          "surface": { "type": "string", "minLength": 1, "maxLength": 500 },
          "role": {
            "type": "string",
            "enum": ["PRIMARY_WRITE", "SUPPORTING_WRITE", "CLOSE_SYNC_WRITE", "EVIDENCE_WRITE"]
          }
        }
      }
    },
    "protectedSurfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "closeSyncSurfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "dependsOn": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "expectedBases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "mode"],
        "properties": {
          "ref": { "type": "string", "minLength": 1, "maxLength": 300 },
          "sha": { "type": "string", "minLength": 7, "maxLength": 64 },
          "mode": { "type": "string", "enum": ["EXACT", "REFRESHABLE"] },
          "mayAdvance": { "type": "boolean", "default": false }
        }
      }
    },
    "sourceAuthorityRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "stopCondition": { "type": "string", "minLength": 1, "maxLength": 1000 }
  }
}
