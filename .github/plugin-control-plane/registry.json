{
  "schemaVersion": 1,
  "managedLabelPrefixes": ["plugin:", "product:", "scope:"],
  "plugins": {
    "local": {
      "displayName": "Local",
      "lifecycle": "compatibility-family",
      "issueValues": ["local", "Local", "Local plugin"],
      "paths": [
        "plugins/risu/local",
        "plugins/risu/local/*",
        "docs/LOCAL_PLUGIN_GUIDELINES.md"
      ],
      "statusAdapter": "evidence",
      "authority": {
        "evidence": "plugins/risu/local/README.md"
      }
    },
    "usage-dashboard": {
      "displayName": "Local Usage Dashboard",
      "lifecycle": "production",
      "issueValues": ["usage-dashboard", "Local Usage Dashboard"],
      "paths": [
        "plugins/usage-dashboard/**",
        "products/usage-dashboard/**",
        "plugins/risu/local/usage-dashboard/**",
        ".github/usage-dashboard/**",
        ".github/workflows/usage-dashboard-*.yml",
        ".github/workflows/reusable-usage-dashboard-*.yml",
        "docs/USAGE_DASHBOARD_*.md"
      ],
      "statusAdapter": "usage-dashboard",
      "authority": {
        "releaseBranch": "release-usage-dashboard",
        "manifest": "plugins/usage-dashboard/runtime/product-manifest.json",
        "artifact": "plugins/usage-dashboard/latest.js",
        "releaseSpecDir": ".github/usage-dashboard/releases"
      }
    },
    "simcore": {
      "displayName": "SimCore",
      "lifecycle": "production",
      "issueValues": ["simcore", "SimCore"],
      "paths": [
        "plugins/simcore/**",
        "products/simcore/**",
        ".github/workflows/simcore-*.yml",
        "docs/SIMCORE_*.md",
        "config/simcore-*.json",
        "product-manifest.json"
      ],
      "statusAdapter": "simcore",
      "authority": {
        "releaseBranch": "release-simcore",
        "manifest": "product-manifest.json",
        "artifact": "plugins/simcore/latest.js"
      }
    },
    "devpass": {
      "displayName": "DevPass",
      "lifecycle": "declared-update-channel",
      "issueValues": ["devpass", "DevPass"],
      "paths": [
        "plugins/risu/local/devpass/**",
        "plugins/devpass/**"
      ],
      "statusAdapter": "devpass",
      "authority": {
        "declaredBy": "plugins/risu/local/devpass/README.md",
        "artifact": "plugins/devpass/latest.js",
        "ref": "main"
      }
    },
    "termux-large-doc-editor": {
      "displayName": "Termux Large Doc Editor",
      "lifecycle": "prototype",
      "issueValues": ["termux-large-doc-editor", "Termux Large Doc Editor"],
      "paths": [
        "plugins/termux/large-doc-editor/**",
        "docs/TERMUX_*.md"
      ],
      "statusAdapter": "prototype",
      "authority": {
        "evidence": "plugins/termux/large-doc-editor/README.md"
      }
    },
    "voyage-token-check": {
      "displayName": "Voyage Token Check",
      "lifecycle": "design-evidence-validation",
      "issueValues": ["voyage-token-check", "Voyage Token Check", "Voyage"],
      "paths": [
        "plugins/risu/local/voyage/**",
        "voyage-token-check/**"
      ],
      "statusAdapter": "evidence",
      "authority": {
        "evidence": "plugins/risu/local/voyage/DESIGN_STATUS.md"
      }
    }
  },
  "products": {
    "app-api-mod-lab": {
      "displayName": "App API Mod Lab",
      "lifecycle": "research-product-root",
      "issueValues": ["app-api-mod-lab", "App API Mod Lab", "앱 API 개조", "앱 API 개조 랩"],
      "paths": [
        "products/app-api-mod-lab/**",
        ".github/workflows/app-api-mod-lab-ci.yml"
      ],
      "statusAdapter": "prototype",
      "authority": {
        "evidence": "products/app-api-mod-lab/CURRENT.md",
        "manifest": "products/app-api-mod-lab/product.json"
      }
    },
    "local-model-lab": {
      "displayName": "Local Model Lab",
      "lifecycle": "research-product-root",
      "issueValues": ["local-model-lab", "Local Model Lab", "로컬 모델", "로컬모델"],
      "paths": [
        "products/local-model-lab/**",
        "docs/LOCAL_MODEL_LAB_GUIDELINES.md"
      ],
      "statusAdapter": "prototype",
      "authority": {
        "evidence": "products/local-model-lab/CURRENT.md",
        "manifest": "products/local-model-lab/product.json"
      }
    },
    "pocketrisu-helper-mod": {
      "displayName": "PocketRisu Helper Mod",
      "lifecycle": "operations-product-root",
      "issueValues": ["pocketrisu-helper-mod", "PocketRisu Helper Mod", "PocketRisu 개조", "포켓리스 보조 개조"],
      "paths": [
        "products/pocketrisu-helper-mod/**",
        ".github/workflows/pocketrisu-helper-docs.yml"
      ],
      "statusAdapter": "pocketrisu-helper-mod",
      "authority": {
        "manifest": "products/pocketrisu-helper-mod/product.json",
        "currentState": "products/pocketrisu-helper-mod/CURRENT.md"
      }
    }
  },
  "scopes": [
    {
      "id": "study",
      "label": "scope:study",
      "displayName": "Study",
      "issueValues": ["study", "Study"],
      "paths": ["study/**"],
      "description": "Independent study and learning root; routing metadata only",
      "authority": {
        "posture": "routing-only",
        "statusProjection": false
      }
    },
    {
      "id": "local-runtime",
      "label": "scope:local-runtime",
      "displayName": "Local Runtime",
      "issueValues": ["local-runtime", "Local Runtime"],
      "paths": ["local/**"],
      "description": "Local runtime root; routing only, not product, device, release, deployment, or production authority",
      "authority": {
        "posture": "routing-only",
        "statusProjection": false
      }
    }
  ],
  "nonOperationalScopes": [
    {
      "id": "research-product",
      "label": "scope:research-product",
      "paths": ["products/chatgpt-mobile-coder-lab/**"]
    },
    {
      "id": "template",
      "label": "scope:template",
      "paths": ["plugins/_template/**"]
    },
    {
      "id": "test-fixture",
      "label": "scope:test-fixture",
      "paths": ["plugins/test-a/**", "plugins/test-b/**"]
    }
  ],
  "repoPaths": [
    ".github/plugin-control-plane/**",
    ".github/workflows/plugin-control-plane-*.yml",
    ".github/ISSUE_TEMPLATE/plugin-work.yml",
    ".github/tooling/ci-summary/manifests/plugin-control-plane.json",
    ".github/workflows/agent-skill-security-benchmark.yml",
    "tools/agent-skill-security/**",
    ".agents/skills/**",
    "docs/REPOSITORY_AGENT_EXECUTION_COMPACTNESS_V1_DESIGN_2026-09-07.md",
    "docs/REPOSITORY_PLUGIN_CONTROL_PLANE_*.md"
  ],
  "sharedPaths": [
    "README.md",
    "products/README.md",
    ".vscode/**",
    ".github/workflows/repo-main-write-coordination-migration.yml"
  ]
}
