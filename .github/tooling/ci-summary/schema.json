{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/repository-ci-summary-v1.schema.json",
  "title": "CI_SUMMARY_V1",
  "type": "object",
  "required": ["schemaVersion", "workflow", "run", "result", "reasonCodes", "source", "complete"],
  "properties": {
    "schemaVersion": {"const": 1},
    "workflow": {"type": "string", "minLength": 1, "maxLength": 160},
    "run": {
      "type": "object",
      "required": ["id", "attempt", "event", "sha"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "attempt": {"type": "integer", "minimum": 0},
        "event": {"type": "string", "minLength": 1, "maxLength": 64},
        "sha": {"type": "string", "minLength": 1, "maxLength": 64}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "product": {"type": "string", "minLength": 1, "maxLength": 128},
        "profile": {"type": "string", "minLength": 1, "maxLength": 128}
      },
      "additionalProperties": false
    },
    "result": {"enum": ["PASS", "NOOP", "FAIL", "INFRA_ERROR", "CANCELLED", "UNKNOWN"]},
    "counts": {
      "type": "object",
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["name", "result"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "result": {"type": "string", "minLength": 1, "maxLength": 64},
          "detail": {"type": "string", "maxLength": 240}
        },
        "additionalProperties": false
      }
    },
    "reasonCodes": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_.:-]{0,127}$"}
    },
    "firstFailure": {
      "type": ["object", "null"],
      "properties": {
        "phase": {"type": "string", "minLength": 1, "maxLength": 128},
        "code": {"type": "string", "minLength": 1, "maxLength": 128},
        "message": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["kind", "path"],
      "properties": {
        "kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "path": {"type": "string", "minLength": 1, "maxLength": 300}
      },
      "additionalProperties": false
    },
    "complete": {"type": "boolean"}
  },
  "additionalProperties": false
}
