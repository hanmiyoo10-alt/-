<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:label="Termux Screen On Companion"
        android:supportsRtl="true">
        <activity
            android:name=".PairingActivity"
            android:exported="true" />
        <receiver
            android:name=".ScreenOnReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.hanmiyoo.screenoncompanion.action.ON" />
                <action android:name="io.hanmiyoo.screenoncompanion.action.OFF" />
                <action android:name="io.hanmiyoo.screenoncompanion.action.STATUS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
