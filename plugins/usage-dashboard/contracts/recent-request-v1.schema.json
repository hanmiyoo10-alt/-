{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-usage-dashboard/recent-request-v1",
  "title": "Local Usage Dashboard Recent Request v1",
  "type": "object",
  "required": ["timestamp", "provider", "model"],
  "properties": {
    "timestamp": { "type": ["string", "number"] },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "sequence": { "type": ["string", "number"] },
    "success": { "type": "boolean" },
    "status": { "type": "string" },
    "errorCode": { "type": ["string", "number"] },
    "errorType": { "type": "string" },
    "cost": { "type": "number", "minimum": 0 },
    "totalTokens": { "type": "number", "minimum": 0 },
    "cacheHit": { "type": "boolean" }
  },
  "additionalProperties": true,
  "$comment": "Metadata-only contract. Prompt and response content are intentionally outside the canonical request detail surface."
}
