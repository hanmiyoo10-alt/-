{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-usage-dashboard/snapshot-v1",
  "title": "Local Usage Dashboard Snapshot v1",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": ["string", "number"] },
    "protocolVersion": { "type": "number" },
    "bridgeVersion": { "type": "string" },
    "fetchedAt": { "type": ["string", "number"] },
    "usageScopes": {
      "type": "object",
      "properties": {
        "scopes": {
          "type": "object",
          "properties": {
            "all": { "$ref": "#/$defs/usageScope" },
            "devpass": { "$ref": "#/$defs/usageScope" },
            "credits": { "$ref": "#/$defs/usageScope" }
          },
          "additionalProperties": true
        },
        "errors": { "type": "object" }
      },
      "additionalProperties": true
    },
    "analyticsScopes": { "type": "object" },
    "modules": { "type": "object" },
    "diagnostics": { "type": "object" }
  },
  "additionalProperties": true,
  "$defs": {
    "aggregateRow": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "requests": { "type": "number", "minimum": 0 },
        "cost": { "type": "number", "minimum": 0 },
        "totalTokens": { "type": "number", "minimum": 0 },
        "inputTokens": { "type": "number", "minimum": 0 },
        "outputTokens": { "type": "number", "minimum": 0 },
        "errorCount": { "type": "number", "minimum": 0 },
        "errorRate": { "type": "number", "minimum": 0 },
        "cacheCount": { "type": "number", "minimum": 0 },
        "cacheRate": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "usageScope": {
      "type": "object",
      "properties": {
        "totalRequests": { "type": "number", "minimum": 0 },
        "totalCost": { "type": "number", "minimum": 0 },
        "totalTokens": { "type": "number", "minimum": 0 },
        "inputTokens": { "type": "number", "minimum": 0 },
        "outputTokens": { "type": "number", "minimum": 0 },
        "errorCount": { "type": "number", "minimum": 0 },
        "errorRate": { "type": "number", "minimum": 0 },
        "cacheCount": { "type": "number", "minimum": 0 },
        "cacheRate": { "type": "number", "minimum": 0 },
        "providers": { "type": "array", "items": { "$ref": "#/$defs/aggregateRow" } },
        "models": { "type": "array", "items": { "$ref": "#/$defs/aggregateRow" } },
        "recent": { "type": "array", "items": { "$ref": "recent-request-v1.schema.json" } }
      },
      "additionalProperties": true
    }
  }
}
