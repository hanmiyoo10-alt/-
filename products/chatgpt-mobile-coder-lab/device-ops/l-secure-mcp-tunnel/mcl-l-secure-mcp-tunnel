#!/usr/bin/env python3
from __future__ import annotations

import fcntl
import os
import re
import signal
import stat
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Callable, Mapping, Sequence

SCHEMA = "mcl-l-secure-mcp-tunnel.v1"
SUPPORTED_TUNNEL_CLIENT_VERSION = "0.0.15"
OFFICIAL_RELEASE_VERSION_RE = re.compile(
    rf"^{re.escape(SUPPORTED_TUNNEL_CLIENT_VERSION)}\+([0-9a-f]{{40}}) \(git sha: \1\)$"
)
TUNNEL_ID_RE = re.compile(r"^tunnel_[0-9a-f]{32}$")
FIXED_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

@dataclass(frozen=True)
class Profile:
    tunnel_client: Path
    repo_mcp: Path
    tunnel_id_file: Path
    runtime_key_file: Path
    state_dir: Path
    health_url_file: Path
    lock_file: Path
    home: Path

PRODUCTION_PROFILE = Profile(
    tunnel_client=Path("/home/alsl0/.local/libexec/mcl-secure-mcp/tunnel-client"),
    repo_mcp=Path("/home/alsl0/.local/share/mcl-secure-mcp/repo-ci-mcp-venv/bin/repo-ci-mcp"),
    tunnel_id_file=Path("/home/alsl0/.config/mcl-secure-mcp/tunnel-id"),
    runtime_key_file=Path("/home/alsl0/.config/mcl-secure-mcp/runtime-api-key"),
    state_dir=Path("/home/alsl0/.local/state/mcl-secure-mcp"),
    health_url_file=Path("/home/alsl0/.local/state/mcl-secure-mcp/health.url"),
    lock_file=Path("/home/alsl0/.local/state/mcl-secure-mcp/run.lock"),
    home=Path("/home/alsl0"),
)

Runner = Callable[[Sequence[str]], subprocess.CompletedProcess[str]]


def _default_runner(argv: Sequence[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        list(argv),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=5,
        check=False,
        env={"PATH": FIXED_PATH, "HOME": str(PRODUCTION_PROFILE.home), "LANG": "C.UTF-8"},
    )


def _receipt(**overrides: object) -> dict[str, object]:
    value: dict[str, object] = {
        "schema": SCHEMA,
        "operation": "unknown",
        "tunnel_client": "unknown",
        "tunnel_client_version": "unknown",
        "repository_read_mcp": "unknown",
        "tunnel_id_ref": "unknown",
        "runtime_key_ref": "unknown",
        "health_bind": "loopback",
        "result": "blocked",
        "reason": "UNKNOWN",
        "details": "withheld",
    }
    value.update(overrides)
    return value


def render_receipt(value: Mapping[str, object]) -> str:
    order = (
        "schema",
        "operation",
        "tunnel_client",
        "tunnel_client_version",
        "repository_read_mcp",
        "tunnel_id_ref",
        "runtime_key_ref",
        "health_bind",
        "result",
        "reason",
        "details",
    )
    return "".join(f"{key}={value[key]}\n" for key in order)


def _lstat_regular(path: Path, *, executable: bool = False, exact_mode: int | None = None) -> str | None:
    try:
        st = path.lstat()
    except FileNotFoundError:
        return "MISSING"
    except OSError:
        return "UNREADABLE"
    if stat.S_ISLNK(st.st_mode):
        return "SYMLINK"
    if not stat.S_ISREG(st.st_mode):
        return "NOT_REGULAR"
    if st.st_uid != os.getuid():
        return "FOREIGN_OWNER"
    mode = stat.S_IMODE(st.st_mode)
    if exact_mode is not None and mode != exact_mode:
        return "MODE_INVALID"
    if executable and mode & (stat.S_IWGRP | stat.S_IWOTH):
        return "WRITABLE_BY_OTHERS"
    if executable and not (mode & stat.S_IXUSR):
        return "NOT_EXECUTABLE"
    return None


def _private_dir(path: Path) -> str | None:
    try:
        st = path.lstat()
    except FileNotFoundError:
        return "MISSING"
    except OSError:
        return "UNREADABLE"
    if stat.S_ISLNK(st.st_mode):
        return "SYMLINK"
    if not stat.S_ISDIR(st.st_mode):
        return "NOT_DIRECTORY"
    if st.st_uid != os.getuid():
        return "FOREIGN_OWNER"
    if stat.S_IMODE(st.st_mode) != 0o700:
        return "MODE_INVALID"
    return None


def _ancestor_problem(path: Path) -> str | None:
    if not path.is_absolute():
        return "PATH_INVALID"
    current = Path("/")
    chain = [current]
    for part in path.parts[1:-1]:
        current /= part
        chain.append(current)
    for directory in chain:
        try:
            st = directory.lstat()
        except FileNotFoundError:
            return "MISSING"
        except OSError:
            return "UNREADABLE"
        if stat.S_ISLNK(st.st_mode):
            return "SYMLINK"
        if not stat.S_ISDIR(st.st_mode):
            return "NOT_DIRECTORY"
        if st.st_uid not in {0, os.getuid()}:
            return "FOREIGN_OWNER"
        if stat.S_IMODE(st.st_mode) & (stat.S_IWGRP | stat.S_IWOTH):
            return "WRITABLE_BY_OTHERS"
    return None


def _read_tunnel_id(path: Path) -> tuple[str | None, str | None]:
    ancestor = _ancestor_problem(path)
    if ancestor:
        return None, f"ANCESTOR_{ancestor}"
    problem = _lstat_regular(path, exact_mode=0o600)
    if problem:
        return None, problem
    try:
        st = path.lstat()
        if st.st_size > 128:
            return None, "INVALID"
        with path.open("rb") as handle:
            data = handle.read(129)
        if len(data) > 128:
            return None, "INVALID"
        raw = data.decode("ascii")
    except (OSError, UnicodeError):
        return None, "UNREADABLE"
    value = raw.strip()
    if not TUNNEL_ID_RE.fullmatch(value):
        return None, "INVALID"
    return value, None


def _check_key_ref(path: Path) -> str | None:
    ancestor = _ancestor_problem(path)
    if ancestor:
        return f"ANCESTOR_{ancestor}"
    problem = _lstat_regular(path, exact_mode=0o600)
    if problem:
        return problem
    try:
        st = path.lstat()
        if not 1 <= st.st_size <= 16384:
            return "INVALID"
        with path.open("rb") as handle:
            data = handle.read(16385)
    except OSError:
        return "UNREADABLE"
    if not 1 <= len(data) <= 16384 or not data.strip():
        return "INVALID"
    return None


def _version(binary: Path, runner: Runner) -> tuple[str | None, str | None]:
    try:
        result = runner((str(binary), "--version"))
    except (OSError, subprocess.SubprocessError):
        return None, "VERSION_CHECK_FAILED"
    if result.returncode != 0:
        return None, "VERSION_CHECK_FAILED"
    raw = result.stdout.strip()
    if len(raw) > 256:
        return None, "VERSION_DRIFT"
    if raw == SUPPORTED_TUNNEL_CLIENT_VERSION:
        return SUPPORTED_TUNNEL_CLIENT_VERSION, None
    if OFFICIAL_RELEASE_VERSION_RE.fullmatch(raw):
        return SUPPORTED_TUNNEL_CLIENT_VERSION, None
    return None, "VERSION_DRIFT"


def check_profile(profile: Profile = PRODUCTION_PROFILE, runner: Runner | None = None) -> tuple[dict[str, object], str | None]:
    runner = runner or _default_runner
    reasons: list[str] = []

    tunnel_state = "exact"
    ancestor = _ancestor_problem(profile.tunnel_client)
    if ancestor:
        tunnel_state = "blocked"
        reasons.append(f"TUNNEL_CLIENT_ANCESTOR_{ancestor}")
    else:
        problem = _lstat_regular(profile.tunnel_client, executable=True)
        if problem:
            tunnel_state = "blocked"
            reasons.append(f"TUNNEL_CLIENT_{problem}")

    version = None
    if tunnel_state == "exact":
        version, problem = _version(profile.tunnel_client, runner)
        if problem:
            tunnel_state = "blocked"
            reasons.append(f"TUNNEL_CLIENT_{problem}")

    repo_state = "exact"
    ancestor = _ancestor_problem(profile.repo_mcp)
    if ancestor:
        repo_state = "blocked"
        reasons.append(f"REPOSITORY_READ_MCP_ANCESTOR_{ancestor}")
    else:
        problem = _lstat_regular(profile.repo_mcp, executable=True)
        if problem:
            repo_state = "blocked"
            reasons.append(f"REPOSITORY_READ_MCP_{problem}")

    tunnel_id, tunnel_problem = _read_tunnel_id(profile.tunnel_id_file)
    tunnel_ref = "present" if tunnel_problem is None else "blocked"
    if tunnel_problem:
        reasons.append(f"TUNNEL_ID_REF_{tunnel_problem}")

    key_problem = _check_key_ref(profile.runtime_key_file)
    key_ref = "present" if key_problem is None else "blocked"
    if key_problem:
        reasons.append(f"RUNTIME_KEY_REF_{key_problem}")

    state_problem = _private_dir(profile.state_dir)
    if state_problem:
        reasons.append(f"STATE_DIR_{state_problem}")
    else:
        if profile.health_url_file.parent != profile.state_dir:
            reasons.append("HEALTH_URL_PARENT_INVALID")
        elif profile.health_url_file.exists() or profile.health_url_file.is_symlink():
            health_problem = _lstat_regular(profile.health_url_file, exact_mode=0o600)
            if health_problem:
                reasons.append(f"HEALTH_URL_FILE_{health_problem}")
        if profile.lock_file.parent != profile.state_dir:
            reasons.append("RUN_LOCK_PARENT_INVALID")
        elif profile.lock_file.exists() or profile.lock_file.is_symlink():
            lock_problem = _lstat_regular(profile.lock_file, exact_mode=0o600)
            if lock_problem:
                reasons.append(f"RUN_LOCK_FILE_{lock_problem}")

    result = "pass" if not reasons else "blocked"
    reason = "PASS" if not reasons else ",".join(sorted(set(reasons)))
    receipt = _receipt(
        operation="check",
        tunnel_client=tunnel_state,
        tunnel_client_version=version or "unknown",
        repository_read_mcp=repo_state,
        tunnel_id_ref=tunnel_ref,
        runtime_key_ref=key_ref,
        result=result,
        reason=reason,
    )
    return receipt, tunnel_id


def build_run_plan(profile: Profile = PRODUCTION_PROFILE, runner: Runner | None = None) -> tuple[dict[str, object], list[str] | None, dict[str, str] | None]:
    receipt, tunnel_id = check_profile(profile, runner)
    if receipt["result"] != "pass" or tunnel_id is None:
        return receipt | {"operation": "run"}, None, None
    argv = [
        str(profile.tunnel_client),
        "run",
        f"--control-plane.api-key=file:{profile.runtime_key_file}",
        f"--mcp.command={profile.repo_mcp}",
        "--health.listen-addr=127.0.0.1:0",
        f"--health.url-file={profile.health_url_file}",
        "--health.show-details=false",
        "--allow-remote-ui=false",
        "--open-web-ui=false",
        "--log.level=info",
        "--log.format=struct-text",
    ]
    env = {
        "PATH": FIXED_PATH,
        "HOME": str(profile.home),
        "LANG": "C.UTF-8",
        "CONTROL_PLANE_TUNNEL_ID": tunnel_id,
        "REPO_CI_GITHUB_REPO": "hanmiyoo10-alt/-",
        "REPO_CI_GITHUB_API": "https://api.github.com",
        "REPO_CI_GITHUB_TIMEOUT_SECONDS": "20",
    }
    start = receipt | {
        "operation": "run",
        "result": "starting",
        "reason": "PREFLIGHT_PASS_NOT_READINESS",
    }
    return start, argv, env


def _remove_safe_health_file(profile: Profile) -> None:
    path = profile.health_url_file
    if not (path.exists() or path.is_symlink()):
        return
    problem = _lstat_regular(path, exact_mode=0o600)
    if problem:
        raise RuntimeError("HEALTH_URL_FILE_UNSAFE")
    path.unlink()


def _acquire_run_lock(profile: Profile) -> int:
    if profile.lock_file.parent != profile.state_dir:
        raise RuntimeError("RUN_LOCK_PARENT_INVALID")
    flags = os.O_RDWR | os.O_CREAT
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(profile.lock_file, flags, 0o600)
    except OSError as error:
        raise RuntimeError("RUN_LOCK_OPEN_FAILED") from error
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or stat.S_IMODE(st.st_mode) != 0o600:
            raise RuntimeError("RUN_LOCK_UNSAFE")
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RuntimeError("RUN_ALREADY_ACTIVE") from error
        os.set_inheritable(fd, False)
        return fd
    except Exception:
        os.close(fd)
        raise


def _default_executor(path: str, argv: Sequence[str], env: Mapping[str, str]) -> int:
    process = subprocess.Popen(
        list(argv),
        executable=path,
        env=dict(env),
        close_fds=True,
    )
    previous_handlers: dict[int, object] = {}

    def forward(signum: int, _frame: object) -> None:
        try:
            process.send_signal(signum)
        except ProcessLookupError:
            pass

    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        previous_handlers[signum] = signal.getsignal(signum)
        signal.signal(signum, forward)
    try:
        return process.wait()
    finally:
        for signum, handler in previous_handlers.items():
            signal.signal(signum, handler)


def main(
    argv: Sequence[str] | None = None,
    *,
    profile: Profile = PRODUCTION_PROFILE,
    runner: Runner | None = None,
    executor: Callable[[str, Sequence[str], Mapping[str, str]], int | None] = _default_executor,
) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if args == ["--check"]:
        receipt, _ = check_profile(profile, runner)
        sys.stdout.write(render_receipt(receipt))
        return 0 if receipt["result"] == "pass" else 3
    if args != ["--run"]:
        sys.stdout.write(render_receipt(_receipt(
            operation="unknown",
            result="blocked",
            reason="ARGUMENT_INVALID",
        )))
        return 64

    receipt, run_argv, run_env = build_run_plan(profile, runner)
    if run_argv is None or run_env is None:
        sys.stdout.write(render_receipt(receipt))
        return 3

    lock_fd: int | None = None
    try:
        os.umask(0o077)
        lock_fd = _acquire_run_lock(profile)
        _remove_safe_health_file(profile)
    except RuntimeError as error:
        if lock_fd is not None:
            os.close(lock_fd)
        reason = str(error)
        if reason not in {
            "RUN_LOCK_PARENT_INVALID",
            "RUN_LOCK_OPEN_FAILED",
            "RUN_LOCK_UNSAFE",
            "RUN_ALREADY_ACTIVE",
            "HEALTH_URL_FILE_UNSAFE",
        }:
            reason = "RUN_PREFLIGHT_EFFECT_FAILED"
        sys.stdout.write(render_receipt(receipt | {"result": "blocked", "reason": reason}))
        return 3

    sys.stdout.write(render_receipt(receipt))
    sys.stdout.flush()
    try:
        child_code = executor(run_argv[0], run_argv, run_env)
    except OSError:
        sys.stdout.write(render_receipt(receipt | {"result": "blocked", "reason": "EXEC_FAILED"}))
        return 4
    finally:
        if lock_fd is not None:
            os.close(lock_fd)
    return 0 if child_code is None else int(child_code)


if __name__ == "__main__":
    raise SystemExit(main())
