#!/usr/bin/env python3
import hashlib
import json
import os
import re
import subprocess
import sys

SCHEMA = "mcl-l-worktree-retire.v1"
MODE = "MCL_L_WORKTREE_RETIRE"
CONTROL = "/home/alsl0/nyang-repo"
WORKTREE_ROOT = "/home/alsl0/nyang-worktrees"
BRANCH_PREFIX = "laptop/"
REMOTE = "origin"
CANONICAL_ORIGIN = "https://github.com/hanmiyoo10-alt/-.git"
HOLDER_FILE = "mcl-workspace-holder.v1.json"
SHA_RE = re.compile(r"^[0-9a-f]{40}$")
TARGET_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
AUTHORITY = {
    "repositoryMutationAuthorized": False,
    "deviceMutationAuthorized": False,
    "mergeAuthorized": False,
    "releaseAuthorized": False,
    "productionAuthorized": False,
}

def _run(args, *, check=True, cwd=None):
    env = dict(os.environ)
    env["GIT_OPTIONAL_LOCKS"] = "0"
    result = subprocess.run(
        args, cwd=cwd, env=env, text=True, stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL, shell=False,
    )
    if check and result.returncode != 0:
        raise RuntimeError("COMMAND_FAILED")
    return result

def _git(control, *args, check=True):
    return _run(["git", "-C", control, *args], check=check)

def _profile(overrides=None):
    value = {
        "control": CONTROL,
        "worktree_root": WORKTREE_ROOT,
        "branch_prefix": BRANCH_PREFIX,
        "remote": REMOTE,
        "origin_url": CANONICAL_ORIGIN,
    }
    if overrides:
        value.update(overrides)
    return value

def _receipt(operation, status, target, expected_head, reasons=None,
             observed_branch=None, observed_head=None, remote_head=None,
             local_head=None):
    return {
        "schema": SCHEMA,
        "mode": MODE,
        "operation": operation,
        "status": status,
        "target": target,
        "branch": f"{BRANCH_PREFIX}{target}" if TARGET_RE.fullmatch(target or "") else None,
        "expectedHead": expected_head,
        "observedBranch": observed_branch,
        "observedHead": observed_head,
        "remoteHead": remote_head,
        "localHead": local_head,
        "reasonCodes": sorted(set(reasons or [])),
        "details": "withheld",
        "authority": dict(AUTHORITY),
    }

def _safe_target(profile, target):
    if not TARGET_RE.fullmatch(target or "") or target in {".", ".."}:
        return None, None, ["TARGET_BASENAME_INVALID"]
    root = os.path.normpath(profile["worktree_root"])
    if os.path.realpath(root) != root:
        return None, None, ["WORKTREE_ROOT_ALIAS"]
    candidate = os.path.normpath(os.path.join(root, target))
    if os.path.dirname(candidate) != root:
        return None, None, ["TARGET_ESCAPE"]
    branch = profile["branch_prefix"] + target
    if _run(["git", "check-ref-format", "--branch", branch], check=False).returncode != 0:
        return None, None, ["BRANCH_INVALID"]
    return candidate, branch, []

def _registered(control):
    result = _git(control, "worktree", "list", "--porcelain", check=False)
    if result.returncode != 0:
        raise RuntimeError("WORKTREE_REGISTRATION_READ_FAILED")
    rows = []
    for block in result.stdout.strip().split("\n\n") if result.stdout.strip() else []:
        item = {}
        for line in block.splitlines():
            key, _, value = line.partition(" ")
            item[key] = value
        rows.append(item)
    return rows

def _local_ref_state(profile, branch):
    ref = f"refs/heads/{branch}"
    symbolic = _git(profile["control"], "symbolic-ref", "-q", ref, check=False)
    if symbolic.returncode == 0:
        return "SYMBOLIC", None
    if symbolic.returncode not in {1}:
        return "ERROR", None
    result = _git(profile["control"], "rev-parse", "--verify", ref, check=False)
    if result.returncode != 0:
        return "MISSING", None
    value = result.stdout.strip()
    if not SHA_RE.fullmatch(value):
        return "INVALID", None
    return "DIRECT", value

def _local_head(profile, branch):
    state, value = _local_ref_state(profile, branch)
    return value if state == "DIRECT" else None

def _remote_binding_reasons(profile):
    fetch = _git(profile["control"], "remote", "get-url", "--all", profile["remote"], check=False)
    push = _git(profile["control"], "remote", "get-url", "--push", "--all", profile["remote"], check=False)
    if fetch.returncode != 0 or push.returncode != 0:
        return ["REMOTE_URL_READ_FAILED"]
    fetch_urls = [line for line in fetch.stdout.splitlines() if line]
    push_urls = [line for line in push.stdout.splitlines() if line]
    expected = profile["origin_url"]
    if fetch_urls != [expected] or push_urls != [expected]:
        return ["REMOTE_URL_BINDING_CONFLICT"]
    return []

def _remote_head(profile, branch):
    ref = f"refs/heads/{branch}"
    result = _git(profile["control"], "ls-remote", "--heads", profile["origin_url"], ref, check=False)
    if result.returncode != 0:
        return "ERROR", None
    rows = [line for line in result.stdout.splitlines() if line.strip()]
    if not rows:
        return "MISSING", None
    if len(rows) != 1:
        return "AMBIGUOUS", None
    sha, sep, observed_ref = rows[0].partition("\t")
    if sep != "\t" or observed_ref != ref or not SHA_RE.fullmatch(sha):
        return "INVALID", None
    return "PRESENT", sha

def _status_reasons(target):
    result = _git(target, "status", "--porcelain=v1", "-z",
                  "--untracked-files=all", "--ignored=matching", check=False)
    if result.returncode != 0:
        return ["WORKTREE_STATUS_READ_FAILED"]
    reasons = []
    for entry in result.stdout.split("\0"):
        if not entry:
            continue
        code = entry[:2]
        if code == "??":
            reasons.append("WORKTREE_UNTRACKED")
        elif code == "!!":
            reasons.append("WORKTREE_IGNORED")
        else:
            if code[0] != " ":
                reasons.append("WORKTREE_STAGED")
            if code[1] != " ":
                reasons.append("WORKTREE_TRACKED_DIRTY")
    visible = _git(target, "ls-files", "-v", "-z", "--", check=False)
    if visible.returncode != 0:
        reasons.append("WORKTREE_INDEX_FLAGS_READ_FAILED")
    else:
        for entry in visible.stdout.split("\0"):
            if not entry:
                continue
            tag = entry[0]
            if tag.islower():
                reasons.append("WORKTREE_ASSUME_UNCHANGED")
            elif tag == "S":
                reasons.append("WORKTREE_SKIP_WORKTREE")
    return sorted(set(reasons))

def _file_digest(path):
    try:
        with open(path, "rb") as handle:
            return "sha256:" + hashlib.sha256(handle.read()).hexdigest()
    except FileNotFoundError:
        return "missing"

def _landing_snapshot(profile):
    control = profile["control"]
    branch = _git(control, "symbolic-ref", "--short", "-q", "HEAD", check=False)
    head = _git(control, "rev-parse", "HEAD", check=False)
    index = _git(control, "ls-files", "-s", "-z", check=False)
    status = _git(control, "status", "--porcelain=v1", "-z",
                  "--untracked-files=all", "--ignored=matching", check=False)
    git_path = _git(control, "rev-parse", "--git-path", "FETCH_HEAD", check=False)
    if head.returncode or index.returncode or status.returncode or git_path.returncode:
        raise RuntimeError("PRESERVATION_READ_FAILED")
    fetch_path = git_path.stdout.strip()
    if not os.path.isabs(fetch_path):
        fetch_path = os.path.join(control, fetch_path)
    return {
        "branch": branch.stdout.strip() if branch.returncode == 0 else None,
        "head": head.stdout.strip(),
        "indexDigest": hashlib.sha256(index.stdout.encode()).hexdigest(),
        "statusDigest": hashlib.sha256(status.stdout.encode()).hexdigest(),
        "fetchHead": _file_digest(fetch_path),
    }

def inspect_target(target, expected_head, *, profile=None):
    profile = _profile(profile)
    reasons = []
    observed_branch = observed_head = remote_head = local_head = None
    if not SHA_RE.fullmatch(expected_head or ""):
        reasons.append("EXPECTED_HEAD_INVALID")
    target_path, branch, target_reasons = _safe_target(profile, target)
    reasons.extend(target_reasons)
    if reasons:
        return {
            "eligible": False, "reasons": sorted(set(reasons)),
            "targetPath": target_path, "branch": branch,
            "observedBranch": None, "observedHead": None,
            "remoteHead": None, "localHead": None,
        }
    if os.path.lexists(target_path) and os.path.islink(target_path):
        reasons.append("TARGET_SYMLINK_OR_ALIAS")
    if not os.path.isdir(target_path):
        reasons.append("TARGET_MISSING")
    elif os.path.realpath(target_path) != target_path:
        reasons.append("TARGET_SYMLINK_OR_ALIAS")
    try:
        registered = _registered(profile["control"])
    except Exception:
        registered = []
        reasons.append("WORKTREE_REGISTRATION_READ_FAILED")
    matches = [row for row in registered if row.get("worktree") == target_path]
    branch_ref = f"refs/heads/{branch}"
    branch_matches = [row for row in registered if row.get("branch") == branch_ref]
    if len(matches) != 1:
        reasons.append("TARGET_NOT_EXACT_REGISTERED_WORKTREE")
    elif matches[0].get("branch") != branch_ref:
        reasons.append("REGISTERED_BRANCH_CONFLICT")
    if len(branch_matches) != 1 or branch_matches[0].get("worktree") != target_path:
        reasons.append("BRANCH_REGISTERED_ELSEWHERE")
    if os.path.isdir(target_path):
        top = _git(target_path, "rev-parse", "--show-toplevel", check=False)
        if top.returncode or top.stdout.strip() != target_path:
            reasons.append("TARGET_TOPLEVEL_CONFLICT")
        b = _git(target_path, "symbolic-ref", "--short", "-q", "HEAD", check=False)
        if b.returncode:
            reasons.append("TARGET_DETACHED")
        else:
            observed_branch = b.stdout.strip()
            if observed_branch != branch:
                reasons.append("TARGET_BRANCH_CONFLICT")
        h = _git(target_path, "rev-parse", "HEAD", check=False)
        if h.returncode:
            reasons.append("TARGET_HEAD_READ_FAILED")
        else:
            observed_head = h.stdout.strip()
            if observed_head != expected_head:
                reasons.append("TARGET_HEAD_CONFLICT")
        reasons.extend(_status_reasons(target_path))
        git_dir = _git(target_path, "rev-parse", "--absolute-git-dir", check=False)
        if git_dir.returncode:
            reasons.append("GIT_ADMIN_READ_FAILED")
        elif os.path.lexists(os.path.join(git_dir.stdout.strip(), HOLDER_FILE)):
            reasons.append("WORKSPACE_HOLDER_PRESENT")
    reasons.extend(_remote_binding_reasons(profile))
    local_state, local_head = _local_ref_state(profile, branch)
    if local_state == "SYMBOLIC":
        reasons.append("LOCAL_BRANCH_SYMBOLIC_REF")
    elif local_state == "MISSING":
        reasons.append("LOCAL_BRANCH_REF_MISSING")
    elif local_state != "DIRECT":
        reasons.append("LOCAL_BRANCH_REF_READ_FAILED")
    elif local_head != expected_head:
        reasons.append("LOCAL_BRANCH_REF_CONFLICT")
    remote_state, remote_head = _remote_head(profile, branch)
    if remote_state == "MISSING":
        reasons.append("REMOTE_BRANCH_MISSING")
    elif remote_state != "PRESENT":
        reasons.append("REMOTE_HEAD_READ_FAILED")
    elif remote_head != expected_head:
        reasons.append("REMOTE_HEAD_CONFLICT")
    return {
        "eligible": not reasons, "reasons": sorted(set(reasons)),
        "targetPath": target_path, "branch": branch,
        "observedBranch": observed_branch, "observedHead": observed_head,
        "remoteHead": remote_head, "localHead": local_head,
    }

def _post_worktree_remove(profile, target_path, branch, expected_head):
    reasons = []
    if os.path.lexists(target_path):
        reasons.append("POST_REMOVE_TARGET_PRESENT")
    try:
        registered = _registered(profile["control"])
        if any(row.get("worktree") == target_path for row in registered):
            reasons.append("POST_REMOVE_REGISTRATION_PRESENT")
        if any(row.get("branch") == f"refs/heads/{branch}" for row in registered):
            reasons.append("POST_REMOVE_BRANCH_REGISTRATION_PRESENT")
    except Exception:
        reasons.append("POST_REMOVE_REGISTRATION_UNKNOWN")
    local_state, local_head = _local_ref_state(profile, branch)
    if local_state == "SYMBOLIC":
        reasons.append("POST_REMOVE_LOCAL_REF_SYMBOLIC")
    elif local_state != "DIRECT" or local_head != expected_head:
        reasons.append("POST_REMOVE_LOCAL_REF_CONFLICT")
    state, remote_head = _remote_head(profile, branch)
    if state != "PRESENT" or remote_head != expected_head:
        reasons.append("POST_REMOVE_REMOTE_REF_CONFLICT")
    return reasons

def apply_target(target, expected_head, *, explicit_apply=False, profile=None,
                 before_recheck=None, before_remote_delete=None,
                 before_local_delete=None):
    profile = _profile(profile)
    if not explicit_apply:
        return _receipt("apply", "BLOCKED", target, expected_head, ["EXPLICIT_APPLY_REQUIRED"])
    try:
        before = _landing_snapshot(profile)
    except Exception:
        return _receipt("apply", "BLOCKED", target, expected_head, ["PRESERVATION_READ_FAILED"])
    first = inspect_target(target, expected_head, profile=profile)
    if not first["eligible"]:
        return _receipt("apply", "BLOCKED", target, expected_head, first["reasons"],
                        first["observedBranch"], first["observedHead"],
                        first["remoteHead"], first["localHead"])
    if before_recheck:
        before_recheck()
    second = inspect_target(target, expected_head, profile=profile)
    if not second["eligible"]:
        return _receipt("apply", "BLOCKED", target, expected_head,
                        ["RECHECK_BLOCKED", *second["reasons"]],
                        second["observedBranch"], second["observedHead"],
                        second["remoteHead"], second["localHead"])
    target_path, branch = second["targetPath"], second["branch"]
    removed = _git(profile["control"], "worktree", "remove", target_path, check=False)
    if removed.returncode:
        return _receipt("apply", "BLOCKED", target, expected_head, ["WORKTREE_REMOVE_FAILED"],
                        second["observedBranch"], second["observedHead"],
                        second["remoteHead"], second["localHead"])
    reasons = _post_worktree_remove(profile, target_path, branch, expected_head)
    if reasons:
        return _receipt("apply", "BLOCKED", target, expected_head, reasons,
                        second["observedBranch"], second["observedHead"],
                        second["remoteHead"], _local_head(profile, branch))
    if before_remote_delete:
        before_remote_delete()
    binding_reasons = _remote_binding_reasons(profile)
    if binding_reasons:
        return _receipt("apply", "BLOCKED", target, expected_head, binding_reasons,
                        second["observedBranch"], second["observedHead"],
                        second["remoteHead"], _local_head(profile, branch))
    ref = f"refs/heads/{branch}"
    lease = f"--force-with-lease={ref}:{expected_head}"
    pushed = _git(profile["control"], "push", lease, profile["origin_url"], f":{ref}", check=False)
    if pushed.returncode:
        state, observed = _remote_head(profile, branch)
        reasons = ["REMOTE_DELETE_REJECTED"]
        if state == "PRESENT" and observed != expected_head:
            reasons.append("REMOTE_HEAD_MOVED")
        return _receipt("apply", "BLOCKED", target, expected_head, reasons,
                        second["observedBranch"], second["observedHead"],
                        observed, _local_head(profile, branch))
    state, observed = _remote_head(profile, branch)
    if state != "MISSING":
        return _receipt("apply", "BLOCKED", target, expected_head,
                        ["POST_REMOTE_DELETE_REF_PRESENT"],
                        second["observedBranch"], second["observedHead"],
                        observed, _local_head(profile, branch))
    if _local_head(profile, branch) != expected_head:
        return _receipt("apply", "BLOCKED", target, expected_head,
                        ["POST_REMOTE_DELETE_LOCAL_REF_CONFLICT"],
                        second["observedBranch"], second["observedHead"],
                        observed, _local_head(profile, branch))
    if before_local_delete:
        before_local_delete()
    local_state, local_head = _local_ref_state(profile, branch)
    if local_state == "SYMBOLIC":
        return _receipt("apply", "BLOCKED", target, expected_head,
                        ["LOCAL_BRANCH_SYMBOLIC_REF"],
                        second["observedBranch"], second["observedHead"],
                        None, None)
    if local_state != "DIRECT" or local_head != expected_head:
        return _receipt("apply", "BLOCKED", target, expected_head,
                        ["LOCAL_DELETE_REJECTED"],
                        second["observedBranch"], second["observedHead"],
                        None, local_head)
    deleted = _git(profile["control"], "update-ref", "--no-deref",
                   "-d", ref, expected_head, check=False)
    if deleted.returncode:
        return _receipt("apply", "BLOCKED", target, expected_head,
                        ["LOCAL_DELETE_REJECTED"],
                        second["observedBranch"], second["observedHead"],
                        None, _local_head(profile, branch))
    final_reasons = []
    if os.path.lexists(target_path):
        final_reasons.append("FINAL_TARGET_PRESENT")
    try:
        registered = _registered(profile["control"])
        if any(row.get("worktree") == target_path for row in registered):
            final_reasons.append("FINAL_REGISTRATION_PRESENT")
        if any(row.get("branch") == f"refs/heads/{branch}" for row in registered):
            final_reasons.append("FINAL_BRANCH_REGISTRATION_PRESENT")
    except Exception:
        final_reasons.append("FINAL_REGISTRATION_UNKNOWN")
    if _local_head(profile, branch) is not None:
        final_reasons.append("FINAL_LOCAL_REF_PRESENT")
    state, observed = _remote_head(profile, branch)
    if state != "MISSING":
        final_reasons.append("FINAL_REMOTE_REF_PRESENT")
    try:
        if _landing_snapshot(profile) != before:
            final_reasons.append("LANDING_PRESERVATION_DRIFT")
    except Exception:
        final_reasons.append("LANDING_PRESERVATION_UNKNOWN")
    return _receipt(
        "apply", "REMOVED" if not final_reasons else "BLOCKED",
        target, expected_head, final_reasons,
        second["observedBranch"], second["observedHead"],
        observed, _local_head(profile, branch),
    )

def _parse(argv):
    if not argv or argv[0] not in {"inspect", "apply"}:
        raise ValueError("COMMAND_INVALID")
    command = argv[0]
    values = {}
    apply_flag = False
    i = 1
    while i < len(argv):
        token = argv[i]
        if token == "--apply":
            if apply_flag:
                raise ValueError("ARGUMENT_DUPLICATE")
            apply_flag = True
            i += 1
            continue
        if token not in {"--target", "--expected-head"} or i + 1 >= len(argv):
            raise ValueError("ARGUMENT_INVALID")
        if token in values:
            raise ValueError("ARGUMENT_DUPLICATE")
        values[token] = argv[i + 1]
        i += 2
    if set(values) != {"--target", "--expected-head"}:
        raise ValueError("ARGUMENT_REQUIRED")
    if command == "inspect" and apply_flag:
        raise ValueError("APPLY_FLAG_WITH_INSPECT")
    return command, values, apply_flag

def run_cli(argv=None, *, profile=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    try:
        command, values, apply_flag = _parse(argv)
        if command == "inspect":
            row = inspect_target(values["--target"], values["--expected-head"], profile=profile)
            receipt = _receipt(
                "inspect", "ELIGIBLE" if row["eligible"] else "BLOCKED",
                values["--target"], values["--expected-head"], row["reasons"],
                row["observedBranch"], row["observedHead"], row["remoteHead"], row["localHead"],
            )
        else:
            receipt = apply_target(
                values["--target"], values["--expected-head"],
                explicit_apply=apply_flag, profile=profile,
            )
    except ValueError as error:
        receipt = _receipt("unknown", "BLOCKED", "unknown", None, [str(error)])
    code = 0 if receipt["status"] in {"ELIGIBLE", "REMOVED"} else 2
    return code, json.dumps(receipt, sort_keys=True, separators=(",", ":")) + "\n"

def main():
    code, text = run_cli()
    sys.stdout.write(text)
    return code

if __name__ == "__main__":
    raise SystemExit(main())
