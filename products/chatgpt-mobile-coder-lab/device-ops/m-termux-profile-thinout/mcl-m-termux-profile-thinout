#!/data/data/com.termux/files/usr/bin/sh
set -u

SCHEMA='mcl-m-termux-profile-thinout.v1'
EXPECTED_PACKAGE='termux-services'
EXPECTED_VERSION='0.13-1'
EXPECTED_STOCK_SHA='8c8b8c5222a74bd037cb059ccbbedd4d94cf1f0b1b76b2df8cfa220b9de9d3f8'
EXPECTED_REPLACEMENT_SHA='1b29e3aed2751b48631ae490e49eda19a80e9e09a62af1e381607b705b2a8652'
EXPECTED_MODE='700'
PREFIX='/data/data/com.termux/files/usr'
TEST_MODE="${MCL_M_TERMUX_PROFILE_THINOUT_TEST_MODE:-0}"

case "$TEST_MODE" in
    0) ;;
    1)
        ROOT="${MCL_M_TERMUX_PROFILE_THINOUT_TEST_ROOT:?test root required}"
        PREFIX="$ROOT/prefix"
        ;;
    *)
        printf '%s\n' \
            "schema=$SCHEMA" \
            'operation=unknown' \
            'state=unknown' \
            "package=$EXPECTED_PACKAGE" \
            "package_version=$EXPECTED_VERSION" \
            'diversion=unknown' \
            'service_daemon_auto_start=unknown' \
            'result=blocked' \
            'reason=invalid_test_mode' \
            'details=withheld'
        exit 64
        ;;
esac

TARGET="$PREFIX/etc/profile.d/start-services.sh"
DIVERT="$PREFIX/etc/profile.d/start-services.sh.mcl-stock"
TMPDIR="$PREFIX/tmp"
DPKG_QUERY="$PREFIX/bin/dpkg-query"
DPKG_DIVERT="$PREFIX/bin/dpkg-divert"
GREP="$PREFIX/bin/grep"
SHA256SUM="$PREFIX/bin/sha256sum"
STAT="$PREFIX/bin/stat"
CHMOD="$PREFIX/bin/chmod"
MV="$PREFIX/bin/mv"
RM="$PREFIX/bin/rm"
MKDIR="$PREFIX/bin/mkdir"

OPERATION='unknown'
STATE='unknown'
DIVERSION='unknown'
AUTO_START='unknown'
RESULT='unknown'
REASON='unknown'

emit() {
    printf '%s\n' \
        "schema=$SCHEMA" \
        "operation=$OPERATION" \
        "state=$STATE" \
        "package=$EXPECTED_PACKAGE" \
        "package_version=$EXPECTED_VERSION" \
        "diversion=$DIVERSION" \
        "service_daemon_auto_start=$AUTO_START" \
        "result=$RESULT" \
        "reason=$REASON" \
        'details=withheld'
}

regular_file() {
    [ -f "$1" ] && [ ! -L "$1" ]
}

file_sha() {
    "$SHA256SUM" "$1" 2>/dev/null | {
        read -r sum _rest || return 1
        printf '%s' "$sum"
    }
}

file_mode() {
    "$STAT" -c '%a' "$1" 2>/dev/null
}

package_ok() {
    [ -x "$DPKG_QUERY" ] || return 1
    version="$("$DPKG_QUERY" -W -f='${Version}' "$EXPECTED_PACKAGE" 2>/dev/null || true)"
    [ "$version" = "$EXPECTED_VERSION" ] || return 1
    owner="$("$DPKG_QUERY" -S "$TARGET" 2>/dev/null || true)"
    printf '%s\n' "$owner" | "$GREP" -Fqx "$EXPECTED_PACKAGE: $TARGET"
}

replacement_write() {
    path="$1"
    {
        printf '%s\n' 'export SVDIR=$PREFIX/var/service'
        printf '%s\n' 'export LOGDIR=$PREFIX/var/log'
    } > "$path" || return 1
    "$CHMOD" "$EXPECTED_MODE" "$path" || return 1
    [ "$(file_sha "$path")" = "$EXPECTED_REPLACEMENT_SHA" ] || return 1
    [ "$(file_mode "$path")" = "$EXPECTED_MODE" ] || return 1
}

classify() {
    STATE='unknown'; DIVERSION='unknown'; AUTO_START='unknown'
    package_ok || { STATE='unknown'; REASON='package_identity_mismatch'; return 3; }
    [ -x "$DPKG_DIVERT" ] || { STATE='unknown'; REASON='dpkg_divert_missing'; return 3; }

    truename="$("$DPKG_DIVERT" --truename "$TARGET" 2>/dev/null || true)"
    if [ "$truename" = "$TARGET" ]; then
        DIVERSION='absent'
        [ ! -e "$DIVERT" ] && [ ! -L "$DIVERT" ] || {
            STATE='conflict'; REASON='unexpected_archive_without_diversion'; return 2;
        }
        regular_file "$TARGET" || { STATE='conflict'; REASON='stock_target_not_regular'; return 2; }
        [ "$(file_sha "$TARGET")" = "$EXPECTED_STOCK_SHA" ] || {
            STATE='drift'; REASON='stock_hash_mismatch'; return 2;
        }
        [ "$(file_mode "$TARGET")" = "$EXPECTED_MODE" ] || {
            STATE='drift'; REASON='stock_mode_mismatch'; return 2;
        }
        STATE='stock'; AUTO_START='present'; REASON='exact_stock'; return 0
    fi

    if [ "$truename" = "$DIVERT" ]; then
        DIVERSION='present'
        regular_file "$TARGET" || { STATE='conflict'; REASON='replacement_not_regular'; return 2; }
        regular_file "$DIVERT" || { STATE='conflict'; REASON='archive_not_regular'; return 2; }
        [ "$(file_sha "$TARGET")" = "$EXPECTED_REPLACEMENT_SHA" ] || {
            STATE='drift'; REASON='replacement_hash_mismatch'; return 2;
        }
        [ "$(file_mode "$TARGET")" = "$EXPECTED_MODE" ] || {
            STATE='drift'; REASON='replacement_mode_mismatch'; return 2;
        }
        [ "$(file_sha "$DIVERT")" = "$EXPECTED_STOCK_SHA" ] || {
            STATE='drift'; REASON='archive_hash_mismatch'; return 2;
        }
        [ "$(file_mode "$DIVERT")" = "$EXPECTED_MODE" ] || {
            STATE='drift'; REASON='archive_mode_mismatch'; return 2;
        }
        STATE='thinned'; AUTO_START='absent'; REASON='exact_thinned'; return 0
    fi

    STATE='conflict'; REASON='unexpected_diversion_target'; return 2
}

rollback_apply() {
    regular_file "$DIVERT" || return 1
    [ "$(file_sha "$DIVERT")" = "$EXPECTED_STOCK_SHA" ] || return 1
    [ "$(file_mode "$DIVERT")" = "$EXPECTED_MODE" ] || return 1

    if [ -e "$TARGET" ] || [ -L "$TARGET" ]; then
        regular_file "$TARGET" || return 1
        [ "$(file_sha "$TARGET")" = "$EXPECTED_REPLACEMENT_SHA" ] || return 1
        [ "$(file_mode "$TARGET")" = "$EXPECTED_MODE" ] || return 1
        "$RM" -f "$TARGET" 2>/dev/null || return 1
    fi

    "$DPKG_DIVERT" --local --remove --rename --divert "$DIVERT" "$TARGET" >/dev/null 2>&1 || return 1
}

do_check() {
    OPERATION='check'
    classify
    rc=$?
    if [ "$rc" -eq 0 ]; then
        RESULT='pass'
        emit
        return 0
    fi
    [ "$rc" -eq 3 ] && RESULT='unknown' || RESULT='blocked'
    emit
    return "$rc"
}

do_apply() {
    OPERATION='apply'
    classify
    rc=$?
    if [ "$rc" -ne 0 ]; then
        [ "$rc" -eq 3 ] && RESULT='unknown' || RESULT='blocked'
        emit
        return "$rc"
    fi
    [ "$STATE" = 'stock' ] || { RESULT='blocked'; REASON='apply_requires_stock'; emit; return 2; }

    "$MKDIR" -p "$TMPDIR" || { RESULT='fail'; REASON='tmpdir_failed'; emit; return 4; }
    tmp="$TMPDIR/mcl-m-termux-profile-thinout.$$"
    "$RM" -f "$tmp" 2>/dev/null || true
    if ! replacement_write "$tmp"; then
        "$RM" -f "$tmp" 2>/dev/null || true
        RESULT='fail'; REASON='replacement_prepare_failed'; emit; return 4
    fi

    if ! "$DPKG_DIVERT" --local --add --rename --divert "$DIVERT" "$TARGET" >/dev/null 2>&1; then
        "$RM" -f "$tmp" 2>/dev/null || true
        RESULT='fail'; REASON='diversion_add_failed'; emit; return 4
    fi
    if ! "$MV" "$tmp" "$TARGET" || ! "$CHMOD" "$EXPECTED_MODE" "$TARGET"; then
        "$RM" -f "$tmp" 2>/dev/null || true
        rollback_apply || true
        RESULT='fail'; REASON='replacement_install_failed'; emit; return 4
    fi

    if classify && [ "$STATE" = 'thinned' ]; then
        RESULT='pass'; REASON='applied'; emit; return 0
    fi
    rollback_apply || true
    classify >/dev/null 2>&1 || true
    RESULT='fail'; REASON='apply_readback_failed'; emit; return 4
}

do_restore() {
    OPERATION='restore'
    classify
    rc=$?
    if [ "$rc" -ne 0 ]; then
        [ "$rc" -eq 3 ] && RESULT='unknown' || RESULT='blocked'
        emit
        return "$rc"
    fi
    [ "$STATE" = 'thinned' ] || { RESULT='blocked'; REASON='restore_requires_thinned'; emit; return 2; }

    if ! "$RM" -f "$TARGET"; then
        RESULT='fail'; REASON='replacement_remove_failed'; emit; return 4
    fi
    if ! "$DPKG_DIVERT" --local --remove --rename --divert "$DIVERT" "$TARGET" >/dev/null 2>&1; then
        replacement_write "$TARGET" >/dev/null 2>&1 || true
        RESULT='fail'; REASON='diversion_remove_failed'; emit; return 4
    fi

    if classify && [ "$STATE" = 'stock' ]; then
        RESULT='pass'; REASON='restored'; emit; return 0
    fi
    RESULT='fail'; REASON='restore_readback_failed'; emit; return 4
}

case "${1:-}" in
    --check) [ "$#" -eq 1 ] || { OPERATION='check'; RESULT='blocked'; REASON='arguments_forbidden'; emit; exit 64; }; do_check ;;
    --apply) [ "$#" -eq 1 ] || { OPERATION='apply'; RESULT='blocked'; REASON='arguments_forbidden'; emit; exit 64; }; do_apply ;;
    --restore) [ "$#" -eq 1 ] || { OPERATION='restore'; RESULT='blocked'; REASON='arguments_forbidden'; emit; exit 64; }; do_restore ;;
    *) OPERATION='unknown'; RESULT='blocked'; REASON='unsupported_operation'; emit; exit 64 ;;
esac
