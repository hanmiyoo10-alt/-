#!/data/data/com.termux/files/usr/bin/sh

PREFIX="/data/data/com.termux/files/usr"
export PATH="$PREFIX/bin:$PATH"

GUARD="$HOME/.local/bin/pocketrisu-core-supervisor-guard"
STATE="$HOME/.local/state/pocketrisu-core-supervisor-guard"
PIDFILE="$STATE/guard.pid"

mkdir -p "$STATE"

[ -x "$GUARD" ] || exit 0

if [ -r "$PIDFILE" ]; then
    pid="$(cat "$PIDFILE" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        cmdline="$(tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
        case "$cmdline" in
            *pocketrisu-core-supervisor-guard*) exit 0 ;;
        esac
    fi
fi

nohup "$GUARD" --loop >> "$STATE/launcher.log" 2>&1 &
exit 0
