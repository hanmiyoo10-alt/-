{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simcore-evidence-index-source-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract", "owner", "authority", "liveEvidence", "fixtureId", "evidenceRelease", "status", "related"],
        "properties": {
          "contract": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128 },
          "owner": { "type": "string", "minLength": 1, "maxLength": 256 },
          "authority": { "type": "string", "minLength": 1, "maxLength": 512 },
          "liveEvidence": { "type": ["string", "null"], "maxLength": 512 },
          "fixtureId": { "type": ["string", "null"], "maxLength": 128 },
          "evidenceRelease": { "type": ["string", "null"], "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "status": { "enum": ["PASS", "WATCH", "GAP"] },
          "related": {
            "type": "array",
            "maxItems": 16,
            "items": { "type": "string", "minLength": 1, "maxLength": 160 }
          }
        }
      }
    }
  }
}
