{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simcore.local/release-approval-schema-v1.json",
  "title": "SimCore Release Approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "candidateReceiptPath",
    "authorityConfirmation"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseId": {
      "type": "string",
      "pattern": "^simcore-v[0-9]+\\.[0-9]+\\.[0-9]+-(new|correction|rollback)-[0-9]{2,}$",
      "maxLength": 96
    },
    "candidateReceiptPath": {
      "type": "string",
      "pattern": "^products/simcore/releases/candidate-receipts/[A-Za-z0-9._-]+\\.json$",
      "maxLength": 240
    },
    "authorityConfirmation": { "const": "RS2_4_RELEASE" }
  }
}
