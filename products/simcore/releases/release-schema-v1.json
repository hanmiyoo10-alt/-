{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simcore.local/release-schema-v1.json",
  "title": "SimCore Release Spec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "product",
    "version",
    "releaseName",
    "releaseMode",
    "candidateCommit",
    "expectedProductionCommit",
    "candidateReleaseBlob",
    "primaryGoalId",
    "changeClass",
    "evidenceRefs",
    "liveGate"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseId": { "type": "string", "pattern": "^simcore-v[0-9]+\\.[0-9]+\\.[0-9]+-(new|correction|rollback|noop)-[0-9]{2,}$", "maxLength": 96 },
    "product": { "const": "SimCore" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32 },
    "releaseName": { "type": "string", "minLength": 1, "maxLength": 160 },
    "releaseMode": { "enum": ["NEW_VERSION", "SAME_VERSION_CORRECTION", "ROLLBACK", "NOOP_IDENTICAL"] },
    "candidateCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "expectedProductionCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidateReleaseBlob": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "primaryGoalId": { "type": "string", "minLength": 1, "maxLength": 80 },
    "changeClass": { "enum": ["RUNTIME_FEATURE", "RUNTIME_CORRECTION", "ROLLBACK", "NOOP"] },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(docs|products/simcore)/" }
    },
    "liveGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "scenarioId", "closeAuthority"],
      "properties": {
        "required": { "type": "boolean" },
        "scenarioId": { "type": "string", "minLength": 1, "maxLength": 96 },
        "closeAuthority": { "enum": ["HUMAN_EVIDENCE", "NOT_REQUIRED"] }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedSafeCommit", "approvedSafeBlob", "reasonCode"],
      "properties": {
        "approvedSafeCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "approvedSafeBlob": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "reasonCode": { "type": "string", "minLength": 1, "maxLength": 96 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "releaseMode": { "const": "ROLLBACK" } }, "required": ["releaseMode"] },
      "then": { "required": ["rollback"] },
      "else": { "not": { "required": ["rollback"] } }
    }
  ]
}
