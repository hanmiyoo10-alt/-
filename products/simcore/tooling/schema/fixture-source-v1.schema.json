{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simcore-fixture-source-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "sourceId",
    "productionVersion",
    "scenario",
    "evidence",
    "proofUnit",
    "target",
    "inputFacts",
    "expectedCandidates",
    "protectedInvariants",
    "observationalFacts",
    "unknowns",
    "minimizationNeeds"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "simcore-live-fixture-source" },
    "sourceId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "productionVersion": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "scenario": { "type": "string", "minLength": 1, "maxLength": 128 },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "additional"],
      "properties": {
        "primary": { "type": "string", "minLength": 1, "maxLength": 512 },
        "additional": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "proofUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "observations"],
      "properties": {
        "kind": { "enum": ["SINGLE", "PAIRED", "SEQUENCE"] },
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suiteCandidate", "semanticOwner", "surfaceCandidate"],
      "properties": {
        "suiteCandidate": { "type": "string", "minLength": 1, "maxLength": 128 },
        "semanticOwner": { "type": "string", "minLength": 1, "maxLength": 128 },
        "surfaceCandidate": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "inputFacts": { "type": "array", "maxItems": 32 },
    "expectedCandidates": { "type": "array", "maxItems": 32 },
    "protectedInvariants": { "type": "array", "maxItems": 32 },
    "observationalFacts": { "type": "array", "maxItems": 32 },
    "unknowns": { "type": "array", "maxItems": 32 },
    "minimizationNeeds": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  }
}
