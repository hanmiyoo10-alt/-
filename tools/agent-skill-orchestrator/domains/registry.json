        {"kind": "release_spec_dir", "value": ".github/usage-dashboard/releases"}
      ],
      "guidelines_path": "docs/USAGE_DASHBOARD_GUIDELINES.md",
      "registration_semantics": "domain_metadata_only_no_skill_promotion"
    }
  ]
}
