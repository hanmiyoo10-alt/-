{
  "schema_version": 1,
  "roles": [
    {
      "role_id": "scout",
      "purpose": "Select relevant supplied evidence and preserve uncertainty without inventing semantic flow.",
      "allowed_record_types": ["claim", "blocker", "conflict"],
      "can_self_verdict": false,
      "can_mutate": false,
      "accepts_raw_upstream_prose": false
    },
    {
      "role_id": "mapper",
      "purpose": "Propose evidence-grounded semantic owners and producer-to-consumer flow edges.",
      "allowed_record_types": ["claim", "flow_edge", "blocker", "conflict"],
      "can_self_verdict": false,
      "can_mutate": false,
      "accepts_raw_upstream_prose": false
    },
    {
      "role_id": "critic",
      "purpose": "Challenge mapped claims and preserve missing boundaries, blockers, UNKNOWN, and CONFLICT.",
      "allowed_record_types": ["claim", "flow_edge", "boundary", "blocker", "conflict"],
      "can_self_verdict": false,
      "can_mutate": false,
      "accepts_raw_upstream_prose": false
    },
    {
      "role_id": "synthesizer",
      "purpose": "Combine only validated upstream records into a narrow structured proposal.",
      "allowed_record_types": ["claim", "flow_edge", "boundary", "blocker", "conflict"],
      "can_self_verdict": false,
      "can_mutate": false,
      "accepts_raw_upstream_prose": false
    }
  ]
}
