{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"colab-bootstrap-request-v1.schema.json","type":"object","additionalProperties":false,"required":["schema_version","request_id","repository_sha","operation_kind","execution_profile_id","max_model_calls","max_wall_minutes","request_sha256"],"properties":{"schema_version":{"type":"integer","const":1},"request_id":{"type":"string","minLength":3,"maxLength":64,"pattern":"^[a-z0-9][a-z0-9-]{2,63}$"},"repository_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"operation_kind":{"type":"string","const":"COLAB_BOOTSTRAP_CPU_SMOKE"},"execution_profile_id":{"type":"string","const":"colab-cpu-bootstrap-v1"},"max_model_calls":{"type":"integer","const":0},"max_wall_minutes":{"type":"integer"},"request_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
