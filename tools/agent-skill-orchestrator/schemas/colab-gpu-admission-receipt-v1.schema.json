{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "colab-gpu-admission-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "execution_surface", "operation_kind", "execution_profile_id",
    "resource_class", "request_id", "request_sha256", "repository_sha",
    "repository_tree_sha", "gpu_admission_state", "hardware", "llama_source",
    "build_profile_id", "build_profile_sha256", "runtime", "started_at_utc",
    "finished_at_utc", "wall_clock_ms", "model_call_count", "hosted_ai_call_count",
    "result_sha256", "bundle_manifest_sha256", "drive_handoff_relative_path",
    "completion_state", "blocker", "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "execution_surface": {"type": "string", "const": "COLAB_MANAGED_GPU_AUX"},
    "operation_kind": {"type": "string", "const": "COLAB_GPU_RUNTIME_SMOKE"},
    "execution_profile_id": {"type": "string", "const": "colab-gpu-runtime-v1"},
    "resource_class": {"type": "string", "const": "GPU_REQUIRED"},
    "request_id": {"type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "gpu_admission_state": {"type": "string", "enum": ["GPU_PRESENT", "GPU_ABSENT"]},
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gpu_present", "gpu_count", "accelerator_name", "total_vram_mib",
        "driver_version", "cuda_driver_version", "cuda_toolkit_version"
      ],
      "properties": {
        "gpu_present": {"type": "boolean"},
        "gpu_count": {"type": "string", "minLength": 1, "maxLength": 8},
        "accelerator_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "total_vram_mib": {"type": "string", "minLength": 1, "maxLength": 32},
        "driver_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "cuda_driver_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "cuda_toolkit_version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "llama_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "release", "source_digest"],
      "properties": {
        "repository": {"type": "string", "const": "https://github.com/ggml-org/llama.cpp.git"},
        "release": {"type": "string", "const": "b10516"},
        "source_digest": {"type": "string", "const": "b95502ba9aa0eb73a2f4fc8878d7fbe6a847a0b9"}
      }
    },
    "build_profile_id": {"type": "string", "const": "llama-b10516-colab-cuda-v1"},
    "build_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_binary_sha256", "cuda_backend_artifact", "cuda_backend_sha256",
        "smoke_state", "smoke_excerpt"
      ],
      "properties": {
        "server_binary_sha256": {"type": "string", "minLength": 7, "maxLength": 64},
        "cuda_backend_artifact": {"type": "string", "minLength": 1, "maxLength": 128},
        "cuda_backend_sha256": {"type": "string", "minLength": 7, "maxLength": 64},
        "smoke_state": {"type": "string", "enum": ["RUNNABLE", "NOT_RUN"]},
        "smoke_excerpt": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "started_at_utc": {"type": "string", "minLength": 1, "maxLength": 64},
    "finished_at_utc": {"type": "string", "minLength": 1, "maxLength": 64},
    "wall_clock_ms": {"type": "integer"},
    "model_call_count": {"type": "integer", "const": 0},
    "hosted_ai_call_count": {"type": "integer", "const": 0},
    "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundle_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "drive_handoff_relative_path": {
      "type": "string",
      "pattern": "^nyang-colab/agent-bench/gpu-admission/[a-z0-9][a-z0-9-]{2,63}$"
    },
    "completion_state": {"type": "string", "enum": ["COMPLETED", "BLOCKED_CAPABILITY"]},
    "blocker": {"type": "string", "enum": ["NONE", "BLOCKED_NO_ACCELERATOR"]},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
