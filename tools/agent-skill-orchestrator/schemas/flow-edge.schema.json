{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flow-edge.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["from", "to", "status", "refs", "role"],
  "properties": {
    "from": {"type": "string", "minLength": 1, "maxLength": 128},
    "to": {"type": "string", "minLength": 1, "maxLength": 128},
    "status": {"type": "string", "enum": ["DIRECT", "SUPPORTED_LIKELY", "UNKNOWN", "CONFLICT"]},
    "refs": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^S[1-9][0-9]*@L[1-9][0-9]*$", "x-known-source-ref": true}},
    "role": {"type": "string", "enum": ["mapper", "critic", "synthesizer"]}
  }
}
