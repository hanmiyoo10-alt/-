{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "local_model_id", "family", "repository", "revision", "file", "sha256", "license", "access", "execution_surface", "enabled"],
  "properties": {
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "local_model_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "family": {"type": "string", "minLength": 1, "maxLength": 64},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "file": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.gguf$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "status": {"type": "string", "enum": ["verified_metadata", "unverified"]},
        "source": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "source"],
      "properties": {
        "class": {"type": "string", "enum": ["public_unauthenticated_https", "gated_requires_token", "unavailable"]},
        "source": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "execution_surface": {"type": "string", "enum": ["LOCAL_GITHUB_HOSTED_CPU_ZERO_AI_CREDITS"]},
    "enabled": {"type": "boolean"}
  }
}
