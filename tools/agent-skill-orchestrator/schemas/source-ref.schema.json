{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-ref.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["ref", "source_sha", "block_digest"],
  "properties": {
    "ref": {"type": "string", "pattern": "^S[1-9][0-9]*@L[1-9][0-9]*$"},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "block_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
