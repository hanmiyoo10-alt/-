{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myang-public-delivery",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/simcore/latest.js",
      "/simcore/install.js",
      "/usage-dashboard/latest.js"
    ]
  }
}
